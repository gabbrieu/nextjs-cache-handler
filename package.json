{
  "name": "@gabrielyncas/nextjs-cache-handler",
  "version": "2.0.0",
  "description": "Incremental Redis cache handler for self-hosted Next.js 15/16, with confirmed invalidation writes and ioredis Cluster TLS/ACL configuration.",
  "keywords": [
    "next",
    "nextjs",
    "cache-handler",
    "redis",
    "ioredis",
    "ISR",
    "self-hosting",
    "incremental"
  ],
  "license": "MIT",
  "author": "Eddy Lee <leejpsd@gmail.com>",
  "homepage": "https://github.com/gabbrieu/nextjs-cache-handler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabbrieu/nextjs-cache-handler.git"
  },
  "type": "module",
  "main": "./dist/incremental/index.cjs",
  "module": "./dist/incremental/index.js",
  "types": "./dist/incremental/index.d.ts",
  "typesVersions": {
    "*": {
      "incremental": [
        "./dist/incremental/index.d.ts"
      ],
      "client/redis": [
        "./dist/shared/client/adapter-redis.d.ts"
      ],
      "client/ioredis": [
        "./dist/shared/client/adapter-ioredis.d.ts"
      ],
      "ops": [
        "./dist/ops/index.d.ts"
      ],
      "otel": [
        "./dist/otel/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/incremental/index.d.ts",
        "default": "./dist/incremental/index.js"
      },
      "require": {
        "types": "./dist/incremental/index.d.cts",
        "default": "./dist/incremental/index.cjs"
      }
    },
    "./incremental": {
      "import": {
        "types": "./dist/incremental/index.d.ts",
        "default": "./dist/incremental/index.js"
      },
      "require": {
        "types": "./dist/incremental/index.d.cts",
        "default": "./dist/incremental/index.cjs"
      }
    },
    "./client/redis": {
      "import": {
        "types": "./dist/shared/client/adapter-redis.d.ts",
        "default": "./dist/shared/client/adapter-redis.js"
      },
      "require": {
        "types": "./dist/shared/client/adapter-redis.d.cts",
        "default": "./dist/shared/client/adapter-redis.cjs"
      }
    },
    "./client/ioredis": {
      "import": {
        "types": "./dist/shared/client/adapter-ioredis.d.ts",
        "default": "./dist/shared/client/adapter-ioredis.js"
      },
      "require": {
        "types": "./dist/shared/client/adapter-ioredis.d.cts",
        "default": "./dist/shared/client/adapter-ioredis.cjs"
      }
    },
    "./ops": {
      "import": {
        "types": "./dist/ops/index.d.ts",
        "default": "./dist/ops/index.js"
      },
      "require": {
        "types": "./dist/ops/index.d.cts",
        "default": "./dist/ops/index.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/otel/index.d.ts",
        "default": "./dist/otel/index.js"
      },
      "require": {
        "types": "./dist/otel/index.d.cts",
        "default": "./dist/otel/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "FORK_NOTES.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:integration:down": "docker compose -f docker-compose.test.yml down",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "publint": "publint",
    "attw": "attw --pack .",
    "version:changesets": "changeset version",
    "publish:changesets": "npm run build && changeset publish",
    "prepublishOnly": "npm run verify:release",
    "test:cluster": "vitest run --config vitest.cluster.config.ts",
    "test:cluster:up": "scripts/cluster-test-env.sh up",
    "test:cluster:down": "scripts/cluster-test-env.sh down",
    "og": "node tools/generate-og.mjs",
    "verify:distribution": "node scripts/verify-distribution.mjs",
    "verify:release": "npm run typecheck && npm run build && npm run publint && npm run attw && npm run verify:distribution"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.0.0",
    "ioredis": ">=5.0.0",
    "next": ">=15.0.0 <17",
    "redis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.0",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.18.0",
    "ioredis": "^5.4.0",
    "next": "^16.1.5",
    "playwright": "^1.60.0",
    "prettier": "^3.4.0",
    "publint": "^0.3.0",
    "redis": "^5.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "contributors": [
    {
      "name": "gabbrieu",
      "url": "https://github.com/gabbrieu"
    }
  ]
}
